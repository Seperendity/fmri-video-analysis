# Track only the maintained experiment package and essential repository guidance.
/*
!/.gitignore
!/README.md
!/fmri_video/

# Maintained experiment source, wrappers, tests, environment, and core Markdown.
/fmri_video/*
!/fmri_video/USAGE.md
!/fmri_video/EXPERIMENTS.md
!/fmri_video/pyproject.toml
!/fmri_video/environment.yml
!/fmri_video/src/
!/fmri_video/src/**
!/fmri_video/scripts/
!/fmri_video/scripts/**
!/fmri_video/tests/
!/fmri_video/tests/**

# Never track data, generated results, papers, binary documents, or local state.
*.doc
*.docx
*.pdf
*.ppt
*.pptx
*.nii
*.nii.gz
*.mat
*.csv
*.tsv
*.xlsx
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.html
*.log
*.tmp
*.orig
*.py[cod]
*.egg-info/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

/archive/
/collaborator_handoff/
/fmri_video/configs/
/fmri_video/data/
/fmri_video/docs/
/fmri_video/outputs/
/fmri_video/provenance/
/fmri_video/resources/

# Local working agreements are excluded from this publication.
AGENTS.md
